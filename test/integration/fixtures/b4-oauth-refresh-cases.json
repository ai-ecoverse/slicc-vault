        }
      },
      "note": "duplicate keys: record which wins. serde_json: the last duplicate wins (JS JSON.parse does the same)."
    },
    {
      "id": "dup-token-type",
      "area": "token-response",
      "setup": {
        "response": {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"access_token\":\"at\",\"token_type\":\"mac\",\"token_type\":\"Bearer\"}"
        },
        "tokenUrl": "https://auth.example/token",
        "nowSecs": 1000
      },
      "expect": {
        "result": "accept",
        "fields": {
          "accessToken": "at"
        }
      },
      "note": "duplicate token_type (mac, then Bearer): record which wins. last duplicate wins, so mac-then-Bearer is accepted; a stricter vault may refuse duplicate keys outright."
    },
