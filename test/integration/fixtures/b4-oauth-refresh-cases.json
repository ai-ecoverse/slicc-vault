    {
      "id": "tt-missing",
      "area": "token-response",
      "setup": {
        "response": {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"access_token\":\"at\",\"expires_in\":3600}"
        },
        "tokenUrl": "https://auth.example/token",
        "nowSecs": 1000
      },
      "expect": {
        "result": "refuse",
        "kind": "invalid_token_type",
        "message": "token_type must be Bearer"
      },
      "note": "token_type absent"
    },
