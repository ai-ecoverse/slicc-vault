    {
      "id": "rot-rotated",
      "area": "rotation",
      "setup": {
        "fakeAs": "b4-oauth-fake-as.mjs /token",
        "mode": {
          "rotate": true,
          "live": ["TOKMARK7f3a-rt1"]
        },
        "request": {
          "method": "POST",
          "contentType": "application/x-www-form-urlencoded",
          "body": "grant_type=refresh_token&refresh_token=TOKMARK7f3a-rt1&client_id=cid"
        },
        "response": {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"access_token\":\"TOKMARK7f3a-at2\",\"refresh_token\":\"TOKMARK7f3a-rt2\",\"expires_in\":60,\"token_type\":\"Bearer\"}"
        },
        "nowSecs": 2000
      },
      "expect": {
        "result": "accept",
        "fields": {
          "accessToken": "TOKMARK7f3a-at2",
          "refreshToken": "TOKMARK7f3a-rt2",
          "expiresAt": 2060
        }
      },
      "note": "the new refresh_token is surfaced; the caller must store it and drop rt1"
    },
    {
      "id": "rot-reused",
      "area": "rotation",
      "setup": {
        "fakeAs": "b4-oauth-fake-as.mjs /token",
        "mode": {
          "rotate": true,
          "live": ["TOKMARK7f3a-rt2"]
        },
        "request": {
          "method": "POST",
          "contentType": "application/x-www-form-urlencoded",
          "body": "grant_type=refresh_token&refresh_token=TOKMARK7f3a-rt1&client_id=cid"
        },
        "response": {
          "status": 400,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"error\":\"invalid_grant\",\"error_description\":\"refresh token reused\"}"
        },
        "nowSecs": 2000
      },
      "expect": {
        "result": "refuse",
        "kind": "idp_error",
        "message": "invalid_grant: refresh token reused"
      },
      "note": "reuse of a rotated token \u2192 IdP invalid_grant \u2192 refuse with idp_error; the vault should treat the grant as revoked"
    },
    {
      "id": "rot-no-new-token",
      "area": "rotation",
      "setup": {
        "fakeAs": "b4-oauth-fake-as.mjs /token",
        "mode": {
          "rotate": false,
          "live": ["TOKMARK7f3a-rt2"]
        },
        "request": {
          "method": "POST",
          "contentType": "application/x-www-form-urlencoded",
          "body": "grant_type=refresh_token&refresh_token=TOKMARK7f3a-rt2&client_id=cid"
        },
        "response": {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"access_token\":\"TOKMARK7f3a-at3\",\"expires_in\":60,\"token_type\":\"Bearer\"}"
        },
        "nowSecs": 2000
      },
      "expect": {
        "result": "accept",
        "fields": {
          "accessToken": "TOKMARK7f3a-at3",
          "expiresAt": 2060
        }
      },
      "note": "no refresh_token in the response: jerk-oauth returns no refreshToken field (it is stateless); the caller keeps the old refresh token per RFC 6749 \u00a76"
    }
