    {
      "id": "rt-empty",
      "area": "token-response",
      "setup": {
        "response": {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"access_token\":\"at\",\"refresh_token\":\"\",\"token_type\":\"Bearer\"}"
        },
        "tokenUrl": "https://auth.example/token",
        "nowSecs": 1000
      },
      "expect": {
        "result": "accept",
        "fields": {
          "accessToken": "at",
          "refreshToken": ""
        }
      },
      "note": "empty refresh_token: record whether it surfaces. jerk-oauth surfaces refreshToken \"\" \u2014 a vault should treat an empty refresh_token as absent (keep the old one) or refuse; storing \"\" would brick the grant."
    },
