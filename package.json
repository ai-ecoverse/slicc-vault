{
  "name": "@ai-ecoverse/slicc-vault",
  "version": "0.0.0",
  "description": "The separate-origin vault at vault.sliccy.ai: sealed secrets, OAuth tokens, and model and MCP credentials for SLICC seven, used only by its injector",
  "piAi": "1.4.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-vault.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-vault",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/contract.d.ts"
    }
  },
  "types": "./dist/types/contract.d.ts",
  "files": [
    "dist/types"
  ],
  "scripts": {
    "prepare": "node scripts/endpoints.mjs && node scripts/jerk-wasm.mjs && slicc-install-hooks",
    "build": "node scripts/endpoints.mjs && node scripts/jerk-wasm.mjs && node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "npm run build && node test/integration/serve.mjs",
    "pretest": "npm run build && slicc-cdp install-browser",
    "test": "node --test --test-timeout=300000 --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "node scripts/endpoints.mjs && node scripts/jerk-wasm.mjs && NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --import fake-indexeddb/auto --test --test-force-exit 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "dependencies": {
    "@ai-ecoverse/jerk-oauth": "1.2.3",
    "@ai-ecoverse/slicc-scrub": "1.0.0"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-cdp": "1.33.1",
    "@ai-ecoverse/slicc-kernel": "1.148.0",
    "@ai-ecoverse/slicc-shared-web": "2.11.1",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.4.0",
    "@happy-dom/global-registrator": "20.14.6",
    "@spectrum-css/button": "14.2.0",
    "@spectrum-css/textfield": "8.2.0",
    "@spectrum-css/tokens": "16.0.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.6",
    "hash-wasm": "4.12.0",
    "js-yaml": "5.5.0",
    "kdbxweb": "2.1.1",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
